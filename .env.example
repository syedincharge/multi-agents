# Copy to .env and fill in real values. NEVER commit .env itself.
#   cp .env.example .env

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: defaults to openai/gpt-4o-mini
OPENROUTER_MODEL=

# Postgres connection string for the LangGraph checkpointer
# e.g. postgresql://user:password@localhost:5432/dbname
DATABASE_URL=

# Langfuse tracing — https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Tavily search — https://app.tavily.com
TAVILY_API_KEY=
